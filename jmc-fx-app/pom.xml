<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent/>
    <artifactId>jmc-fx-app</artifactId>
    <name>JMC FX Application</name>
    <dependencies>
        <dependency>
            <groupId>com.youngledo.jmcfx</groupId>
            <artifactId>jmc-fx-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.youngledo.jmcfx</groupId>
            <artifactId>jmc-fx-adapter-jmc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.youngledo.jmcfx.app.JmcFxApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>native-package</id>
            <properties>
                <jmcfx.package.input.dir>${project.build.directory}/jpackage-input</jmcfx.package.input.dir>
                <jmcfx.package.runtime.dir>${project.build.directory}/jpackage-runtime</jmcfx.package.runtime.dir>
                <jmcfx.package.version>1.0.0</jmcfx.package.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <outputDirectory>${jmcfx.package.input.dir}</outputDirectory>
                            <archive>
                                <manifest>
                                    <mainClass>com.youngledo.jmcfx.app.JmcFxApplication</mainClass>
                                    <addClasspath>true</addClasspath>
                                </manifest>
                            </archive>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-runtime-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${jmcfx.package.input.dir}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jlink-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>create-jpackage-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jlink</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <output>${jmcfx.package.runtime.dir}</output>
                            <modulePaths>
                                <modulePath>${jmcfx.package.input.dir}</modulePath>
                            </modulePaths>
                            <addModules>
                                <addModule>java.desktop</addModule>
                                <addModule>java.management</addModule>
                                <addModule>java.naming</addModule>
                                <addModule>java.rmi</addModule>
                                <addModule>java.sql</addModule>
                                <addModule>jdk.attach</addModule>
                                <addModule>jdk.jfr</addModule>
                                <addModule>jdk.management.agent</addModule>
                                <addModule>jdk.unsupported</addModule>
                                <addModule>javafx.controls</addModule>
                                <addModule>javafx.fxml</addModule>
                            </addModules>
                            <noHeaderFiles>true</noHeaderFiles>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.4</version>
                        <executions>
                            <execution>
                                <id>create-native-package</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>JMC FX</name>
                            <appVersion>${jmcfx.package.version}</appVersion>
                            <vendor>Youngledo</vendor>
                            <description>${project.description}</description>
                            <input>${jmcfx.package.input.dir}</input>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <mainClass>com.youngledo.jmcfx.app.JmcFxApplication</mainClass>
                            <runtimeImage>${jmcfx.package.runtime.dir}</runtimeImage>
                            <destination>${project.build.directory}/jpackage</destination>
                            <removeDestination>true</removeDestination>
                            <verbose>true</verbose>
                            <javaOptions>
                                <option>--enable-native-access=javafx.graphics</option>
                            </javaOptions>
                            <macPackageIdentifier>com.youngledo.jmcfx</macPackageIdentifier>
                            <macPackageName>JMC FX</macPackageName>
                            <linuxPackageName>jmc-fx</linuxPackageName>
                            <linuxAppCategory>Development</linuxAppCategory>
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winMenuGroup>JMC FX</winMenuGroup>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-package-full-runtime</id>
            <properties>
                <jmcfx.package.input.dir>${project.build.directory}/jpackage-input</jmcfx.package.input.dir>
                <jmcfx.package.version>1.0.0</jmcfx.package.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <outputDirectory>${jmcfx.package.input.dir}</outputDirectory>
                            <archive>
                                <manifest>
                                    <mainClass>com.youngledo.jmcfx.app.JmcFxApplication</mainClass>
                                    <addClasspath>true</addClasspath>
                                </manifest>
                            </archive>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-runtime-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${jmcfx.package.input.dir}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.4</version>
                        <executions>
                            <execution>
                                <id>create-native-package</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>JMC FX</name>
                            <appVersion>${jmcfx.package.version}</appVersion>
                            <vendor>Youngledo</vendor>
                            <description>${project.description}</description>
                            <input>${jmcfx.package.input.dir}</input>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <mainClass>com.youngledo.jmcfx.app.JmcFxApplication</mainClass>
                            <runtimeImage>${java.home}</runtimeImage>
                            <destination>${project.build.directory}/jpackage</destination>
                            <removeDestination>true</removeDestination>
                            <verbose>true</verbose>
                            <javaOptions>
                                <option>--enable-native-access=javafx.graphics</option>
                            </javaOptions>
                            <macPackageIdentifier>com.youngledo.jmcfx</macPackageIdentifier>
                            <macPackageName>JMC FX</macPackageName>
                            <linuxPackageName>jmc-fx</linuxPackageName>
                            <linuxAppCategory>Development</linuxAppCategory>
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winMenuGroup>JMC FX</winMenuGroup>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
