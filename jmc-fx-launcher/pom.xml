<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent/>
    <artifactId>jmc-fx-launcher</artifactId>
    <name>JMC FX Launcher</name>
    <dependencies>
        <dependency>
            <groupId>io.github.youngledo.jmcfx</groupId>
            <artifactId>jmc-fx-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.youngledo.jmcfx</groupId>
            <artifactId>jmc-fx-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testCompilerArgs>
                        <arg>--add-reads</arg>
                        <arg>io.github.youngledo.jmcfx.launcher=java.xml</arg>
                    </testCompilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>io.github.youngledo.jmcfx.launcher/io.github.youngledo.jmcfx.launcher.JmcFxLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Leyden packaging intentionally stays behind an explicit profile.
            Binding this installer flow to the default build would make package and verify generate
            a native installer instead of just building and testing the launcher jar.
            Use:
              ./mvnw -pl jmc-fx-launcher -am -Pjpackage-classpath-jlink-leyden package
            The standalone io.github.youngledo:jpackage-maven-plugin provides a Leyden-enhanced goal
            that derives platform paths, installer types, AOT cache locations, and
            macOS signing internally.
        -->
        <profile>
            <id>jpackage-classpath-jlink-leyden</id>
            <properties>
                <jmcfx.package.version>1.0.0</jmcfx.package.version>
                <jpackage.appVersion>${jmcfx.package.version}</jpackage.appVersion>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.youngledo</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>0.1.0</version>
                        <executions>
                            <execution>
                                <id>leyden-jpackage-installer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>leyden</goal>
                                </goals>
                                <configuration>
                                    <name>JMC FX</name>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>io.github.youngledo.jmcfx.launcher.JmcFxLauncher</mainClass>
                                    <packageVersion>${jmcfx.package.version}</packageVersion>
                                    <vendor>Youngledo</vendor>
                                    <description>${project.description}</description>
                                    <runtimeModules>
                                        <runtimeModule>java.desktop</runtimeModule>
                                        <runtimeModule>java.management</runtimeModule>
                                        <runtimeModule>java.naming</runtimeModule>
                                        <runtimeModule>java.rmi</runtimeModule>
                                        <runtimeModule>java.sql</runtimeModule>
                                        <runtimeModule>jdk.attach</runtimeModule>
                                        <runtimeModule>jdk.jfr</runtimeModule>
                                        <runtimeModule>jdk.management.agent</runtimeModule>
                                        <runtimeModule>jdk.unsupported</runtimeModule>
                                        <runtimeModule>javafx.controls</runtimeModule>
                                    </runtimeModules>
                                    <javaOptions>
                                        <option>--enable-native-access=javafx.graphics</option>
                                    </javaOptions>
                                    <trainingProperty>jmcfx.leyden.training</trainingProperty>
                                    <aotCacheName>jmcfx-startup.aot</aotCacheName>
                                    <inputDirectory>${project.build.directory}/jpackage-leyden-input</inputDirectory>
                                    <runtimeDirectory>${project.build.directory}/jpackage-leyden-runtime</runtimeDirectory>
                                    <appImageDirectory>${project.build.directory}/jpackage-leyden-app-image</appImageDirectory>
                                    <packageDirectory>${project.build.directory}/jpackage-leyden</packageDirectory>
                                    <macPackageIdentifier>io.github.youngledo.jmcfx</macPackageIdentifier>
                                    <macPackageName>JMC FX</macPackageName>
                                    <linuxPackageName>jmc-fx</linuxPackageName>
                                    <linuxAppCategory>Development</linuxAppCategory>
                                    <winMenu>true</winMenu>
                                    <winShortcut>true</winShortcut>
                                    <winMenuGroup>JMC FX</winMenuGroup>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
